# ─── 开发环境（示例文件）───
# 使用说明：
#   1) 复制本文件为 application-dev.yml
#        cp application-dev.yml.example application-dev.yml
#   2) 填入真实的本地开发密钥
#   application-dev.yml 已被 .gitignore 排除，不会提交到仓库。
#
# 登录策略：真实身份来自企微客服（external_userid → JWT → 小程序卡片 token），小程序侧不做 wx.login。
# 开发时关闭鉴权，直开小程序用 mock 用户即可全功能联调；生产（application.yml）保持开启走企微卡片 token。
xiaoliao:
  auth:
    enabled: false
    mock-user-id: 7764978f-9019-4b2f-b6b1-11862c1a5528
  wx:
    # 小程序测试号（预留：将来若要启用 wx.login 直开登录再使用）
    appid: ${WX_APPID:}
    secret: ${WX_SECRET:}
  security:
    # 敏感字段加密密钥（dev 固定值；生产用环境变量 XIAOLIAO_DATA_KEY）
    data-key: ${XIAOLIAO_DATA_KEY:}
  pexels:
    # Pexels 图库 API Key（生产用环境变量 XIAOLIAO_PEXELS_KEY）
    key: ${XIAOLIAO_PEXELS_KEY:}
  ai:
    # 本地 AI 引擎 .env 里的 API_TOKEN（生产用环境变量 AI_API_TOKEN 注入）
    api-token: ${AI_API_TOKEN:}
  asr:
    # 语音识别 Key（与 AI 引擎共用阿里云百炼账号；生产用环境变量 QWEN_API_KEY 注入）
    api-key: ${QWEN_API_KEY:}
  deepseek:
    # DeepSeek Key（生产用环境变量 DEEPSEEK_API_KEY 覆盖）
    api-key: ${DEEPSEEK_API_KEY:}

spring:
  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:xiaoliao}
    username: ${DB_USER:xiaoliao}
    password: ${DB_PASSWORD:xiaoliao_dev}
    driver-class-name: org.postgresql.Driver

  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}

  # 开发时打印 SQL
mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

logging:
  level:
    com.xiaoliao: DEBUG
    me.chanjar.weixin: DEBUG

# ---- 企业微信（微信客服）----
wecom:
  corp-id: ${WECOM_CORP_ID:}
  secret: ${WECOM_SECRET:}
  token: ${WECOM_TOKEN:}
  aes-key: ${WECOM_AES_KEY:}
  kf:
    open-kfid: ${WECOM_KF_OPEN_KFID:}
  poll:
    enabled: false
    interval-ms: 10000
  group-reminder:
    enabled: false
    webhook: ${WECOM_GROUP_REMINDER_WEBHOOK:}
    cron: 0 0 9 * * ?
    content: 现在是九点，该打卡啦～ 需要帮助可以点击群里的「客服助理」
    webhook-content: 现在是九点，该打卡啦～ 需要帮助可点击 [客服助理](https://work.weixin.qq.com/kfid/kfc46eff57a06e15e48)
    window-hours: 48
  miniprogram:
    appid: ''
