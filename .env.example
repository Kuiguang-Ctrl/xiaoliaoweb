# ─── 数据库 ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xiaoliao
DB_USER=xiaoliao
DB_PASSWORD=xiaoliao_dev

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── AI 引擎地址 ───
# 本地开发: http://localhost:8081
# Docker部署: http://ai-engine:8081
AI_SERVICE_URL=http://localhost:8081

# ─── Spring Profile ───
SPRING_PROFILES_ACTIVE=dev

# ─── 企业微信（客户提供的配置） ───
# 企微后台: 我的企业 → 企业信息 → 企业ID
WECOM_CORP_ID=
# 企微后台: 应用 → 微信客服 → Secret
WECOM_SECRET=
# 回调 Token（自己生成随机字符串）
WECOM_TOKEN=
# 回调 EncodingAESKey（自己生成43位随机）
WECOM_AES_KEY=
# 企微后台: 开通「微信客服」→ 创建客服账号 → 客服ID
WECOM_KF_OPEN_KFID=
# 小程序 AppID（发小程序卡片用，可选）
WECOM_MINIPROGRAM_APPID=

# ─── DeepSeek API（给 Python AI 引擎用） ───
DEEPSEEK_API_KEY=sk-your-key-here

# ─── 通义千问 API（给 Python AI 引擎用） ───
QWEN_API_KEY=sk-your-key-here
